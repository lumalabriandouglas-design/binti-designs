rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isHouse() {
      return request.auth != null
        && request.auth.token.email == 'bintidesigns442@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /pieces/{pieceId} {
      allow read: if true;
      allow create, update, delete: if isHouse();
    }

    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'phone', 'note', 'pieceSlug', 'createdAt'])
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 32;
      allow read, update, delete: if isHouse();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
